{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/agent-authority-conformance/schema/federation-producer-package-v1.schema.json",
  "title": "Federation Producer Package v1",
  "description": "A manifest for a consumer to pin producer artifacts without importing the producer implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "producer_revision", "consumer_contract", "package_files", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "federation-producer-package-v1"},
    "producer": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "producer_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "consumer_contract": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "package_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}