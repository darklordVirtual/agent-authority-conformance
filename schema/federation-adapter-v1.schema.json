{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC federation adapter manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "adapter",
    "artifacts",
    "claims",
    "explicit_non_claims",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "federation-adapter-v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "source_class",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "source_class": {
            "enum": [
              "producer_artifact",
              "independent_observation",
              "test_fixture",
              "source_code",
              "run_record",
              "review_record"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "procedure",
          "artifacts",
          "claim_ceiling"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "native_claim": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "aac_mapping": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "property",
              "relationship",
              "rationale"
            ],
            "properties": {
              "property": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F",
                  "G",
                  null
                ]
              },
              "relationship": {
                "enum": [
                  "exact",
                  "structural",
                  "partial",
                  "false_analog",
                  "no_mapping",
                  "not_evaluated"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maintainer_review_required": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "PRIVATE_UNTIL_APPROVED",
            "PUBLIC_AFTER_REVIEW",
            "PUBLIC_IMMEDIATE",
            "PUBLIC_BY_MUTUAL_CONSENT"
          ]
        },
        "producer_review": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "NOT_REQUIRED"
          ]
        },
        "review_window_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unresolved_disagreement": {
          "enum": [
            "PUBLISH_WITH_DISAGREEMENT",
            "HOLD_PUBLICATION",
            "SUPERSEDE_WITH_NEW_RUN"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "maintainer_review_required"
          ]
        },
        {
          "required": [
            "mode"
          ]
        }
      ]
    }
  }
}
