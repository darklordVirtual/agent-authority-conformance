{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AACP project onboarding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "roles", "surfaces", "claims", "execution", "review"],
  "properties": {
    "schema_version": {"const": "aacp-project-v1"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "revision"],
      "properties": {
        "name": {"type": "string", "pattern": "\\S"},
        "repository": {"type": "string", "pattern": "^(UNKNOWN|https://[^\\s]+)$"},
        "revision": {"type": "string", "pattern": "^(AUTO|UNKNOWN|[0-9a-fA-F]{40})$"}
      }
    },
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["producer", "consumer", "verifier", "reproduction"]}
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "\\S"},
          "role": {"enum": ["producer", "consumer", "verifier", "reproduction"]},
          "contract": {"type": "string", "pattern": "\\S"},
          "consumes": {"type": "string", "pattern": "\\S"}
        },
        "allOf": [
          {"if": {"properties": {"role": {"const": "producer"}}}, "then": {"required": ["contract"]}},
          {"if": {"properties": {"role": {"const": "consumer"}}}, "then": {"required": ["consumes"]}}
        ]
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery"],
      "properties": {"discovery": {"enum": ["manual", "assisted"]}}
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["external_code", "network"],
      "properties": {
        "external_code": {"const": "deny_by_default"},
        "network": {"const": "deny_by_default"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["publication"],
      "properties": {
        "publication": {"enum": ["PRIVATE_UNTIL_APPROVED", "PUBLIC_AFTER_REVIEW", "PUBLIC_IMMEDIATE", "PUBLIC_BY_MUTUAL_CONSENT"]}
      }
    }
  }
}