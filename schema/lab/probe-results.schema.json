{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/agent-authority-conformance/schema/lab/probe-results.schema.json",
  "title": "AAC lab results/probes.json (v0.3)",
  "description": "Runner-authored probes over pinned bytes. A probe is not a claim result and never maps to PASS or FAIL. Assessment levels live in SCOPE.json and are never summed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note",
    "records"
  ],
  "properties": {
    "note": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "enum": [
              "overall",
              "score",
              "total",
              "aggregate",
              "grade"
            ]
          }
        },
        "required": [
          "probe",
          "class",
          "inputs",
          "evidence",
          "execution",
          "observation"
        ],
        "properties": {
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^:]+:sha256:[0-9a-f]{64}$"
            }
          },
          "execution": {
            "enum": [
              "COMPLETED",
              "INVALID_INPUT",
              "UNSUPPORTED",
              "ERROR",
              "NOT_ADMITTED"
            ]
          },
          "observation": {
            "enum": [
              "DEMONSTRATED",
              "NOT_DEMONSTRATED",
              null
            ]
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "affects_pinned_artifact": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "witness": {
            "type": "object"
          },
          "verifier_error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "execution": {
                  "const": "COMPLETED"
                }
              }
            },
            "then": {
              "required": [
                "reads",
                "affects_pinned_artifact",
                "message",
                "witness"
              ],
              "properties": {
                "observation": {
                  "enum": [
                    "DEMONSTRATED",
                    "NOT_DEMONSTRATED"
                  ]
                }
              },
              "not": {
                "required": [
                  "verifier_error"
                ]
              }
            },
            "else": {
              "required": [
                "verifier_error"
              ],
              "properties": {
                "observation": {
                  "const": null
                }
              }
            }
          }
        ]
      }
    }
  }
}
