{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/agent-authority-conformance/schema/aacp-adversarial-run-v1.schema.json",
  "title": "AACP portable adversarial self-run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_version", "independence", "bcr_level", "properties", "cases", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "aacp-adversarial-run-v1"},
    "suite_version": {"const": "aacp-portable-cfg-adversarial-v1"},
    "independence": {"const": "SELF_RUN"},
    "bcr_level": {"const": "BCR-0"},
    "properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["C", "F", "G"]}
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "property", "execution", "result", "detail", "claim_ceiling"],
        "properties": {
          "id": {"type": "string", "pattern": "^[CFG]-[0-9]{2}$"},
          "property": {"enum": ["C", "F", "G"]},
          "execution": {"enum": ["COMPLETED", "UNSUPPORTED", "INVALID_INPUT", "ERROR"]},
          "result": {"type": ["string", "null"], "enum": ["ESTABLISHED", "CONTRADICTED", "NOT_ESTABLISHED", null]},
          "detail": {"type": "string"},
          "claim_ceiling": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"execution": {"const": "COMPLETED"}}},
            "then": {"properties": {"result": {"enum": ["ESTABLISHED", "CONTRADICTED", "NOT_ESTABLISHED"]}}},
            "else": {"properties": {"result": {"type": "null"}}}
          }
        ]
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}