{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/agent-authority-conformance/schema/assessment.schema.json",
  "title": "Agent Authority Conformance Assessment",
  "description": "Machine-readable representation of a scoped A-G authority conformance assessment. Aggregate scoring is intentionally unsupported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "system",
    "system_version",
    "revision",
    "assessed_at",
    "scope",
    "properties"
  ],
  "properties": {
    "spec_version": {
      "const": "0.1"
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "system_version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable commit, release digest or other pinned revision where available."
    },
    "assessed_at": {
      "type": "string",
      "format": "date"
    },
    "assessor": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_model", "external_effects", "trust_assumptions", "explicit_non_claims"],
      "properties": {
        "process_model": {
          "type": "string",
          "minLength": 1
        },
        "deployment_model": {
          "type": "string"
        },
        "external_effects": {
          "type": "string",
          "enum": ["real", "simulated", "mixed", "none"]
        },
        "trust_assumptions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "explicit_non_claims": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/propertyAssessment"
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["test", "fixture", "artifact", "code", "ci", "release", "other"]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "propertyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "property",
        "status",
        "evidence_tier",
        "reasoning",
        "caveat",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "E", "F", "G"]
        },
        "property": {
          "type": "string",
          "enum": [
            "Receipt Integrity",
            "Authority Provenance",
            "Exact-Call Integrity",
            "Semantic Authority",
            "Execution-Boundary Integrity",
            "TOCTOU Resistance",
            "Effect Verification"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "UNTESTED", "OUT_OF_SCOPE", "FAIL"]
        },
        "evidence_tier": {
          "type": "string",
          "enum": ["RESOLVED", "REPORTED", "NONE"]
        },
        "claimed_status": {
          "type": "string"
        },
        "supported_scope": {
          "type": "string"
        },
        "untested_remainder": {
          "type": "string"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "caveat": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceReference"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "PASS"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"evidence_tier": {"const": "RESOLVED"}},
            "required": ["supported_scope"]
          }
        }
      ]
    }
  }
}
