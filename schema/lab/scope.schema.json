{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/agent-authority-conformance/schema/lab/scope.schema.json",
  "title": "AAC lab SCOPE.json (v0.3)",
  "description": "Structure only. The lab's stdlib validator also checks cross-references (claim inputs, subject indexes, temporal claims). No aggregate keys are allowed.",
  "type": "object",
  "propertyNames": {
    "not": {
      "enum": [
        "overall",
        "score",
        "total",
        "aggregate",
        "grade"
      ]
    }
  },
  "required": [
    "lab_version",
    "run_id",
    "kind",
    "independence",
    "runner",
    "subjects",
    "claim_ceiling"
  ],
  "properties": {
    "lab_version": {
      "const": "0.3"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kind": {
      "enum": [
        "adequacy",
        "verification"
      ]
    },
    "agreement_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^https://"
        }
      ]
    },
    "independence": {
      "enum": [
        "SELF_RUN",
        "REPRODUCTION",
        "SECOND_IMPLEMENTATION",
        "INDEPENDENT_IMPLEMENTATION"
      ]
    },
    "independence_statement": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "object",
      "required": [
        "project",
        "maintainers"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agreement_parties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "propertyNames": {
          "not": {
            "enum": [
              "overall",
              "score",
              "total",
              "aggregate",
              "grade"
            ]
          }
        },
        "required": [
          "project",
          "maintainers",
          "repo",
          "commit",
          "paths",
          "files_sha256",
          "license",
          "attribution"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "maintainers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(^/|(^|/)\\.\\.(/|$))"
              }
            }
          },
          "files_sha256": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "object",
      "required": [
        "establishes",
        "does_not_establish"
      ],
      "properties": {
        "establishes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "does_not_establish": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "private_first",
        "approvers",
        "unreleased_citable"
      ],
      "properties": {
        "private_first": {
          "const": true
        },
        "unreleased_citable": {
          "const": false
        },
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "propertyNames": {
          "not": {
            "enum": [
              "overall",
              "score",
              "total",
              "aggregate",
              "grade"
            ]
          }
        },
        "required": [
          "id",
          "command",
          "projection",
          "fault_sets",
          "cases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "string",
              "pattern": "\\{case\\}"
            }
          },
          "projection": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fault_sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expected_from": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "path",
              "list_key",
              "id_key",
              "field"
            ]
          },
          "independent": {
            "type": "boolean"
          },
          "not_independent_reason": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "independent": {
                  "const": false
                }
              },
              "required": [
                "independent"
              ]
            },
            "then": {
              "required": [
                "not_independent_reason"
              ]
            }
          }
        ]
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "positive",
        "inert"
      ],
      "properties": {
        "positive": {
          "type": "string",
          "minLength": 1
        },
        "inert": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "enum": [
            "native",
            "corpus_adequacy"
          ]
        },
        "cross_check": {
          "enum": [
            null,
            "native",
            "corpus_adequacy"
          ]
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "subject"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|(^|/)\\.\\.(/|$))"
            }
          },
          "subject": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "propertyNames": {
          "not": {
            "enum": [
              "overall",
              "score",
              "total",
              "aggregate",
              "grade"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "layer",
          "check",
          "reads_fields",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$"
          },
          "reads_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "temporal": {
            "type": "boolean"
          },
          "independent": {
            "type": "boolean"
          },
          "not_independent_reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "claim_ceiling": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "establishes",
              "does_not_establish"
            ],
            "properties": {
              "establishes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "does_not_establish": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          "negative_controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "independent": {
                  "const": false
                }
              },
              "required": [
                "independent"
              ]
            },
            "then": {
              "required": [
                "not_independent_reason"
              ]
            }
          }
        ]
      }
    },
    "reference_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_run": {
      "type": "object",
      "required": [
        "run_id",
        "plan_sha256"
      ]
    },
    "runner_authored": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "track": {
      "enum": [
        "manual",
        "self_service"
      ],
      "description": "Absent means manual."
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "commit",
        "path",
        "offer_id",
        "sha256"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^https://"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "offer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "offer_terms": {
      "type": "object",
      "description": "Written by pin from the pinned offer: publication, maintainers, expires."
    },
    "verifier_authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Who wrote the verifier or adapter, when not the runner maintainers."
    },
    "trust_material": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Disclosure of keys and trust roots the checks rely on, e.g. that pinned keys are the fixture's published test keys."
    },
    "procedure": {
      "type": "string",
      "pattern": "\\S",
      "description": "Procedure id; required for self_service (the offered procedure)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "independence": {
            "const": "INDEPENDENT_IMPLEMENTATION"
          }
        },
        "required": [
          "independence"
        ]
      },
      "then": {
        "required": [
          "independence_statement"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "adequacy"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "rows",
          "controls",
          "engine"
        ],
        "properties": {
          "subjects": {
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verification"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "inputs",
          "claims"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "self_service"
          }
        },
        "required": [
          "track"
        ]
      },
      "then": {
        "required": [
          "offer",
          "procedure"
        ],
        "properties": {
          "kind": {
            "const": "verification"
          },
          "subjects": {
            "maxItems": 1
          }
        },
        "not": {
          "required": [
            "publication"
          ]
        }
      },
      "else": {
        "required": [
          "agreement_ref",
          "agreement_parties",
          "publication"
        ]
      }
    }
  ]
}
