{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/agent-authority-conformance/schema/lab/faults.schema.json",
  "title": "AAC lab fault set or control (v0.3)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "name",
        "set",
        "source",
        "faults"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "set": {
          "enum": [
            "known",
            "held_out"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "author",
            "ref"
          ],
          "properties": {
            "author": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "faults": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "class",
              "file",
              "anchor",
              "replacement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "(^/|(^|/)\\.\\.(/|$))"
                }
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "replacement": {
                "type": "string",
                "minLength": 1
              },
              "targets_claim": {
                "type": "string",
                "minLength": 1
              },
              "expected_distinguishing_inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "polarity": {
                "enum": [
                  "positive",
                  "inert"
                ]
              }
            }
          }
        }
      }
    },
    {
      "allOf": [
        {
          "type": "object",
          "required": [
            "id",
            "class",
            "file",
            "anchor",
            "replacement"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "class": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(^/|(^|/)\\.\\.(/|$))"
              }
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            },
            "replacement": {
              "type": "string",
              "minLength": 1
            },
            "targets_claim": {
              "type": "string",
              "minLength": 1
            },
            "expected_distinguishing_inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "polarity": {
              "enum": [
                "positive",
                "inert"
              ]
            }
          }
        },
        {
          "required": [
            "polarity"
          ]
        }
      ]
    }
  ]
}
