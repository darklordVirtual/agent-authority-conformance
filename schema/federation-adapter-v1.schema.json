{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC federation adapter manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "adapter",
    "artifacts",
    "claims",
    "explicit_non_claims",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "federation-adapter-v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "source_class",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "source_class": {
            "enum": [
              "producer_artifact",
              "independent_observation",
              "test_fixture",
              "source_code",
              "run_record",
              "review_record"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "procedure",
          "artifacts",
          "claim_ceiling"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              null
            ]
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "maintainer_review_required"
      ],
      "properties": {
        "maintainer_review_required": {
          "const": true
        },
        "publication_rule": {
          "type": "string"
        }
      }
    }
  }
}
