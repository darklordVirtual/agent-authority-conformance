{
  "contract": "Input is {tool}, a served MCP tool definition. The result is \"sha256:\" + hex digest of the JCS form of {profile, tool restricted to name, title, description, inputSchema, outputSchema, annotations}.",
  "operation": "agentavow.tool_digest",
  "specification": "interop/fixtures/agentavow-tool-manifest-digest-v1.json derivation.tool_digest (AgentAvow v1)",
  "suite": "aacp-reference-vectors-v1",
  "vectors": [
    {
      "description": "Definition digest of the served tool 'ask_wiki_question'; _meta is never hashed.",
      "expected": {
        "result": "sha256:171a53c9725874258b0b1125bc1d1c517e1b02f91a236096a37f53cc3a763dc9"
      },
      "expected_source": "producer:interop/fixtures/agentavow-tool-manifest-digest-v1.json attestation.jws payload scan.toolDigests['tool:ask_wiki_question'] (issuer-signed)",
      "id": "avow-digest-ask_wiki_question",
      "input": {
        "tool": {
          "_meta": {
            "_fastmcp": {
              "tags": []
            }
          },
          "description": "Ask any question about a GitHub repository's codebase and get an AI-powered answer\ngrounded in its DeepWiki.",
          "inputSchema": {
            "properties": {
              "question": {
                "description": "The question to ask about the repository.",
                "type": "string"
              },
              "repoName": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ],
                "description": "GitHub repository or list of repositories (max 10) in owner/repo format."
              }
            },
            "required": [
              "repoName",
              "question"
            ],
            "type": "object"
          },
          "name": "ask_wiki_question",
          "outputSchema": {
            "properties": {
              "result": {
                "type": "string"
              }
            },
            "required": [
              "result"
            ],
            "type": "object",
            "x-fastmcp-wrap-result": true
          }
        }
      }
    },
    {
